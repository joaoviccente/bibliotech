{
  "name": "projeto_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api": "node api/server.js",
    "api:dev": "nodemon api/server.js",
    "dev:full": "concurrently \"npm run api:dev\" \"npm run dev\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "db:reset": "npx prisma migrate reset --force && npm run prisma:seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "next": "15.4.3",
    "nodemon": "^3.1.10",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.3",
    "prisma": "^6.12.0",
    "puppeteer": "^24.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "tailwindcss": "^4"
  }
}
